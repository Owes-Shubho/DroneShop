PORT=5000
# Local MongoDB, or paste a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/droneshop
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Optional email (without these, emails are printed to the server console)
